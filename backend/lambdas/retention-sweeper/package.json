{
  "name": "@cd/retention-sweeper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "bundle": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --external:pg-native --outfile=dist/index.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "catalog:",
    "@cd/dispute-domain": "workspace:*",
    "@cd/shared": "workspace:*",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cd/db": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/pg": "catalog:",
    "testcontainers": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
