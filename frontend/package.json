{
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "name": "@cd/web",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:api": "pnpm run gen:api:users && pnpm run gen:api:transactions && pnpm run gen:api:disputes",
    "gen:api:users": "openapi-typescript ../docs/openapi/users.public.yaml --export-type --immutable -o src/api/generated/users.ts",
    "gen:api:transactions": "openapi-typescript ../docs/openapi/transactions.public.yaml --export-type --immutable -o src/api/generated/transactions.ts",
    "gen:api:disputes": "openapi-typescript ../docs/openapi/disputes.public.yaml --export-type --immutable -o src/api/generated/disputes.ts",
    "check:api": "pnpm run gen:api:users --check && pnpm run gen:api:transactions --check && pnpm run gen:api:disputes --check"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "oidc-client-ts": "catalog:",
    "@tanstack/react-query": "catalog:",
    "openapi-fetch": "catalog:"
  },
  "devDependencies": {
    "vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "openapi-typescript": "catalog:",
    "vitest": "catalog:",
    "jsdom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:"
  }
}
