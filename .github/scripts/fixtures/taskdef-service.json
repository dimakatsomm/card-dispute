{
  "taskDefinition": {
    "taskDefinitionArn": "arn:aws:ecs:af-south-1:111111111111:task-definition/cd-users:3",
    "family": "cd-users",
    "revision": 3,
    "status": "ACTIVE",
    "registeredAt": "2026-01-01T00:00:00Z",
    "registeredBy": "arn:aws:sts::111111111111:assumed-role/x/y",
    "compatibilities": ["EC2", "FARGATE"],
    "requiresAttributes": [{ "name": "com.amazonaws.ecs.capability.logging-driver.awslogs" }],
    "taskRoleArn": "arn:aws:iam::111111111111:role/cd/cd-users-task",
    "executionRoleArn": "arn:aws:iam::111111111111:role/cd/cd-users-exec",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "runtimePlatform": { "cpuArchitecture": "ARM64", "operatingSystemFamily": "LINUX" },
    "volumes": [{ "name": "tmp" }],
    "containerDefinitions": [
      {
        "name": "users",
        "image": "111111111111.dkr.ecr.af-south-1.amazonaws.com/cd-svc-users:initial",
        "essential": true,
        "user": "10001",
        "readonlyRootFilesystem": true,
        "environment": [{ "name": "LOG_LEVEL", "value": "info" }],
        "secrets": [{ "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:af-south-1:111111111111:secret:cd/dev/db/users_app:url::" }],
        "portMappings": [{ "name": "public", "containerPort": 8080, "protocol": "tcp" }],
        "healthCheck": { "command": ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/health"] }
      },
      {
        "name": "sidecar",
        "image": "public.ecr.aws/example/sidecar:1",
        "essential": false
      }
    ]
  }
}
