# Local stack defaults. Copy to local/.env only to override; nothing here is a real secret.

# Host ports (chosen to avoid clashing with common tools; 54322 is taken on the dev machine)
POSTGRES_HOST_PORT=55432
MOTO_HOST_PORT=55000
MOCK_ISSUER_HOST_PORT=55900

# Postgres (superuser for local bootstrap only; per-service roles come with the migrations)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-postgres-password
POSTGRES_DB=disputes

# moto / AWS emulation (dummy credentials: moto accepts anything)
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
MOTO_BUCKETS=cd-evidence-quarantine,cd-evidence
MOTO_QUEUE=dispute-notifications
MOTO_MAX_RECEIVE_COUNT=5

# mock-issuer
# Token `iss`. Must be reachable by the browser; services fetch JWKS from http://mock-issuer:55900 instead.
MOCK_ISSUER_URL=http://localhost:55900
MOCK_ISSUER_TEST_HOOKS=false
MOCK_ISSUER_CLIENT_SECRET=local-dev-client-secret
MOCK_ISSUER_SPA_REDIRECT_URIS=http://localhost:5173/,http://localhost:5173/callback
# Optional: stable signing key (PKCS8 PEM, newlines as \n). Unset = new key on every start.
MOCK_ISSUER_PRIVATE_KEY_PEM=
# Optional: JSON array of {clientId, secret, allowedScopes, redirectUris} replacing the built-in clients.
MOCK_ISSUER_CLIENTS=

# Local-only role passwords used by `pnpm seed:local` (bootstrap rotates roles to these) and by services in L-02.
DB_PASSWORD_AUTH_MIGRATOR=local-dev-auth_migrator-password
DB_PASSWORD_AUTH_APP=local-dev-auth_app-password
DB_PASSWORD_USERS_MIGRATOR=local-dev-users_migrator-password
DB_PASSWORD_USERS_APP=local-dev-users_app-password
DB_PASSWORD_TRANSACTIONS_MIGRATOR=local-dev-transactions_migrator-password
DB_PASSWORD_TRANSACTIONS_APP=local-dev-transactions_app-password
DB_PASSWORD_DISPUTES_MIGRATOR=local-dev-disputes_migrator-password
DB_PASSWORD_DISPUTES_APP=local-dev-disputes_app-password
DB_PASSWORD_DISPUTES_RETENTION=local-dev-disputes_retention-password
